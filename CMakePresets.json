{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Development (Debug, Ninja, Axmol runtime)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ROLO_RUNTIME_BACKEND": "axmol",
                "ROLO_WARNINGS_AS_ERRORS": "ON"
            },
            "warnings": {
                "dev": false
            }
        },
        {
            "name": "release",
            "displayName": "Release (Ninja, Axmol runtime)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ROLO_RUNTIME_BACKEND": "axmol"
            },
            "warnings": {
                "dev": false
            }
        },
        {
            "name": "core",
            "displayName": "Core only (no window, no Axmol; builds in seconds)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/core",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ROLO_RUNTIME_BACKEND": "none",
                "ROLO_WARNINGS_AS_ERRORS": "ON"
            },
            "warnings": {
                "dev": false
            }
        },
        {
            "name": "asan",
            "displayName": "Core only + Address/UB sanitizers",
            "inherits": "core",
            "binaryDir": "${sourceDir}/build/asan",
            "cacheVariables": {
                "ROLO_ENABLE_SANITIZERS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "core",
            "configurePreset": "core"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "package",
            "displayName": "Package Rolo (dist/)",
            "configurePreset": "release",
            "targets": [
                "rolo_package"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "core",
            "configurePreset": "core",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "displayName": "Configure, build and test (Debug, with window)",
            "steps": [
                {
                    "type": "configure",
                    "name": "dev"
                },
                {
                    "type": "build",
                    "name": "dev"
                },
                {
                    "type": "test",
                    "name": "dev"
                }
            ]
        },
        {
            "name": "core",
            "displayName": "Configure, build and test (core only)",
            "steps": [
                {
                    "type": "configure",
                    "name": "core"
                },
                {
                    "type": "build",
                    "name": "core"
                },
                {
                    "type": "test",
                    "name": "core"
                }
            ]
        },
        {
            "name": "release",
            "displayName": "Release: configure, build, test and package into dist/",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "test",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "package"
                }
            ]
        }
    ]
}
