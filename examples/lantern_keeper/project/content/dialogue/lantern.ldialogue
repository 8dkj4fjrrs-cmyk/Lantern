    {
      "id": "dark",
      "text": "The great lantern is cold and dark. It needs its three flames. ({flames}/3)",
      "next": null
    },
    {
      "id": "light",
      "text": "You set the three flames inside the great lantern...",
      "next": "whoosh"
    },
    {
      "id": "whoosh",
      "text": "For a moment, nothing. Then, with a soft whoosh, warm light spills across Emberwick.",
