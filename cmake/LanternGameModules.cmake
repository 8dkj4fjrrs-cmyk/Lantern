# Game modules: a game's C++ behaviours, linked into the editor and player.
#
#   lantern_add_game_module(<name> SOURCES <files...>)
#       Builds a static library <name> from the game's sources. One of them
#       must define the module's registration function:
#           LANTERN_GAME_MODULE(<name>) { registry.add(MyBehaviour::componentType()); }
#       <name> may contain only letters, digits and underscores (it becomes
#       part of a C++ function name).
#
#   lantern_link_game_modules(<target> [MODULES <names...>])
#       Links game modules into an executable and generates the code that
#       calls their registration functions (lantern::registerGameModules()).
#       Without MODULES, every module added so far is linked.
#
# See docs/gameplay.md.

function(lantern_add_game_module name)
    cmake_parse_arguments(ARG "" "" "SOURCES" ${ARGN})
    if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Game module name '${name}' may contain only letters, digits and underscores.")
    endif()
    if(NOT ARG_SOURCES)
        message(FATAL_ERROR "lantern_add_game_module(${name}) needs SOURCES.")
    endif()
    add_library(${name} STATIC ${ARG_SOURCES})
    target_link_libraries(${name} PUBLIC lantern::gameplay)
    lantern_set_warnings(${name})
    set_property(GLOBAL APPEND PROPERTY LANTERN_GAME_MODULES ${name})
endfunction()

function(lantern_link_game_modules target)
    cmake_parse_arguments(ARG "" "" "MODULES" ${ARGN})
    if(DEFINED ARG_MODULES)
        set(modules ${ARG_MODULES})
    else()
        get_property(modules GLOBAL PROPERTY LANTERN_GAME_MODULES)
    endif()

    set(declarations "")
    set(names "")
    set(calls "")
    foreach(module IN LISTS modules)
        string(APPEND declarations "LANTERN_GAME_MODULE(${module});\n")
        string(APPEND names "    \"${module}\",\n")
        string(APPEND calls "    {\n        GameModuleRegistry module(registry, log, \"${module}\");\n        lanternRegisterGameModule_${module}(module);\n    }\n")
    endforeach()
    list(LENGTH modules count)

    set(output "${CMAKE_CURRENT_BINARY_DIR}/${target}_game_modules.cpp")
    file(CONFIGURE OUTPUT "${output}" CONTENT [[
// Generated by lantern_link_game_modules() (cmake/LanternGameModules.cmake). Do not edit.
#include "lantern/gameplay/GameModule.hpp"

#include <array>

@declarations@
namespace lantern {

std::span<const std::string_view> linkedGameModules()
{
    static constexpr std::array<std::string_view, @count@> kNames{
@names@    };
    return kNames;
}

void registerGameModules(ComponentRegistry& registry, const Logger& log)
{
    static_cast<void>(registry);
    static_cast<void>(log);
@calls@}

} // namespace lantern
]] @ONLY)
    target_sources(${target} PRIVATE "${output}")
    target_link_libraries(${target} PRIVATE lantern::gameplay ${modules})
endfunction()
