# rolo_embed_files(<target> NAMESPACE <ns> FILES <symbol>=<path> ...)
#
# Compiles binary files (fonts, icons) into <target>, so programs need no
# separate asset files at run time. For each SYMBOL=PATH pair it generates
#     extern const unsigned char SYMBOL[];      // the bytes
#     extern const std::size_t   SYMBOL_size;   // how many
# in namespace <ns>. Declare them in a hand-written header.
#
# The data is regenerated whenever an input file changes.

function(rolo_embed_files target)
    cmake_parse_arguments(arg "" "NAMESPACE" "FILES" ${ARGN})
    set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/embedded")
    file(MAKE_DIRECTORY "${out_dir}")

    foreach(pair IN LISTS arg_FILES)
        string(FIND "${pair}" "=" eq)
        string(SUBSTRING "${pair}" 0 ${eq} symbol)
        math(EXPR start "${eq} + 1")
        string(SUBSTRING "${pair}" ${start} -1 path)
        get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")

        set(out_file "${out_dir}/${symbol}.cpp")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")

        file(READ "${path}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR byte_count "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # Break the very long line every 32 bytes so compilers and editors cope.
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")

        set(content "// Generated by cmake/RoloEmbed.cmake from ${path}. Do not edit.\n")
        string(APPEND content "#include <cstddef>\n\nnamespace ${arg_NAMESPACE} {\n")
        string(APPEND content "extern const unsigned char ${symbol}[];\nextern const std::size_t ${symbol}_size;\n")
        string(APPEND content "const unsigned char ${symbol}[] = {\n${bytes}\n};\n")
        string(APPEND content "const std::size_t ${symbol}_size = ${byte_count};\n}\n")

        # Only rewrite when changed, so unrelated reconfigures do not rebuild.
        set(existing "")
        if(EXISTS "${out_file}")
            file(READ "${out_file}" existing)
        endif()
        if(NOT existing STREQUAL content)
            file(WRITE "${out_file}" "${content}")
        endif()
        target_sources(${target} PRIVATE "${out_file}")
    endforeach()
endfunction()
